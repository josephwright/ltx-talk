\input docstrip.tex
\askforoverwritefalse

% The comment prefix is set per generated file below, so it must not be
% fixed when the preamble and postamble are stored
\let\MetaPrefix\relax

% stop DocStrip adding rather wordy text
\preamble
\endpreamble
\postamble
Copyright (C) 2023-2026 by
  Joseph Wright <joseph@texdev.net>

