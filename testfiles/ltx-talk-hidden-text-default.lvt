% The default: the Lua code is loaded, but no glyphs are removed
\ExplSyntaxOn
\TYPE
  {
    remove-hidden-text~=~
    \bool_if:NTF \l__talk_remove_hidden_text_bool { true } { false }
  }
\ExplSyntaxOff
\ifdefined\directlua
  \directlua{
    texio.write_nl("term and log", "Lua module "
      .. (talk and "loaded" or "not loaded") .. ", removal "
      .. (luatexbase.in_callback("pre_shipout_filter",
        "ltx-talk.hidden-text") and "on" or "off"))
  }
\fi

