\input{regression-test}

\DocumentMetadata{tagging = draft}
\documentclass{ltx-talk}

\START

\ExplSyntaxOn
\cs_new_protected:Npn \test:n #1
  {
    \group_begin:
      \str_clear:N \l__talk_action_spec_str
      \__talk_block_set:n {#1}
      \TYPE { Input:~ \tl_to_str:n {#1} }
      \TYPE { Keys~passed~on:~ \tl_to_str:N \l__talk_tmp_tl }
      \TYPE { Action~spec:~ \exp_not:V \l__talk_action_spec_str }
    \group_end:
  }

\TEST { Parsing~list~options }
  {
    \test:n {item-label = \Alph*.}
    \test:n { start = 4 }
    \test:n { item-label = \Alph*. , start = 2}
    \test:n { <+-> }
    \test:n { <+-> , item-label = ( \roman* ) }
    \test:n { <2-> , start = 3 }
  }

\END

